{
  "_comment": "Live config. unify carries the actual prose (Gemini 3.1 Pro). editor is deliberately a different lab/architecture (Mistral Large 3) so it isn't grading its own homework. Load is spread so no provider takes more than 2 back-to-back calls a chapter: Groq gets skeleton/action/atmosphere/summariser (each a different model, so none stacks on one model's own sub-quota), Mistral just character+editor after its free tier 429'd under 4 roles' worth of rapid sequential calls.",

  "skeleton":   { "role": "skeleton",   "provider": "openai_compatible",
                  "model": "openai/gpt-oss-120b",
                  "base_url": "https://api.groq.com/openai/v1",
                  "api_key_env": "GROQ_API_KEY" },

  "action":     { "role": "action",     "provider": "openai_compatible",
                  "model": "openai/gpt-oss-20b",
                  "base_url": "https://api.groq.com/openai/v1",
                  "api_key_env": "GROQ_API_KEY" },

  "character":  { "role": "character",  "provider": "openai_compatible",
                  "model": "mistral-medium-latest",
                  "base_url": "https://api.mistral.ai/v1",
                  "api_key_env": "MISTRAL_API_KEY" },

  "atmosphere": { "role": "atmosphere", "provider": "openai_compatible",
                  "model": "qwen/qwen3.6-27b",
                  "base_url": "https://api.groq.com/openai/v1",
                  "api_key_env": "GROQ_API_KEY" },

  "unify":      { "role": "unify",      "provider": "gemini", "model": "gemini-3.1-pro-preview" },

  "editor":     { "role": "editor",     "provider": "openai_compatible",
                  "model": "mistral-large-latest",
                  "base_url": "https://api.mistral.ai/v1",
                  "api_key_env": "MISTRAL_API_KEY" },

  "summariser": { "role": "summariser", "provider": "openai_compatible",
                  "model": "qwen/qwen3.6-27b",
                  "base_url": "https://api.groq.com/openai/v1",
                  "api_key_env": "GROQ_API_KEY" }
}
